# Rangos ocultos: solo se ven con /trigger levelrank.
scoreboard players operation #c so_ar = @s so_ar_rank
execute if score #c so_ar matches ..2 run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Recluta (C)", "color": "white", "bold": true}, {"text": " · Contratos completados: ", "color": "gray"}, {"score": {"name": "@s", "objective": "so_ar_rank"}, "color": "white"}]
execute if score #c so_ar matches 3..5 run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Veterano (B)", "color": "green", "bold": true}, {"text": " · Contratos completados: ", "color": "gray"}, {"score": {"name": "@s", "objective": "so_ar_rank"}, "color": "white"}]
execute if score #c so_ar matches 6..9 run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Élite (A)", "color": "aqua", "bold": true}, {"text": " · Contratos completados: ", "color": "gray"}, {"score": {"name": "@s", "objective": "so_ar_rank"}, "color": "white"}]
execute if score #c so_ar matches 10.. run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Leyenda (S)", "color": "gold", "bold": true}, {"text": " · Contratos completados: ", "color": "gray"}, {"score": {"name": "@s", "objective": "so_ar_rank"}, "color": "white"}]
tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Próximo rango: 3 / 6 / 10 contratos completados según el nivel.", "color": "gray", "bold": false}]
