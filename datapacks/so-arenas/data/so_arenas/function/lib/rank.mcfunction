# Rangos ocultos: solo se ven con /trigger levelrank.
scoreboard players operation #c so_ar = @s so_ar_rank
execute unless score #c so_ar matches 0.. run scoreboard players set #c so_ar 0
execute if score #c so_ar matches ..2 run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Recluta (C)", "color": "white", "bold": true}, {"text": " · Contratos cumplidos: ", "color": "gray", "bold": false}, {"score": {"name": "#c", "objective": "so_ar"}, "color": "white"}]
execute if score #c so_ar matches 3..5 run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Veterano (B)", "color": "green", "bold": true}, {"text": " · Contratos cumplidos: ", "color": "gray", "bold": false}, {"score": {"name": "#c", "objective": "so_ar"}, "color": "white"}]
execute if score #c so_ar matches 6..9 run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Élite (A)", "color": "aqua", "bold": true}, {"text": " · Contratos cumplidos: ", "color": "gray", "bold": false}, {"score": {"name": "#c", "objective": "so_ar"}, "color": "white"}]
execute if score #c so_ar matches 10.. run tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Rango: ", "color": "gray", "bold": false}, {"text": "Leyenda (S)", "color": "gold", "bold": true}, {"text": " · Contratos cumplidos: ", "color": "gray", "bold": false}, {"score": {"name": "#c", "objective": "so_ar"}, "color": "white"}]
tellraw @s [{"text": "[Arena] ", "color": "gold", "bold": true}, {"text": "Próximos rangos: 3 / 6 / 10 contratos cumplidos.", "color": "gray", "bold": false}]
