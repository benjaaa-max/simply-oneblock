{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Coliseo VorNeX",
    "color": "gold",
    "bold": true
  },
  "external_title": {
    "text": "Arena"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Practicá, cumplí contratos y volvé con botín. Los mercaderes del lobby venden flechas, pociones, tótems y más.",
        "color": "gray"
      }
    }
  ],
  "columns": 2,
  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": {
        "text": "Práctica por tiers",
        "color": "yellow"
      },
      "width": 170,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "so_arenas:practice"
      }
    },
    {
      "label": {
        "text": "Contratos",
        "color": "aqua"
      },
      "width": 170,
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "so_arenas:contracts"
      }
    },
    {
      "label": {
        "text": "Unirse al desafío",
        "color": "green"
      },
      "width": 170,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger arena_con set 9"
      },
      "tooltip": {
        "text": "Entrar al foso si ya hay un desafío en curso.",
        "color": "gray"
      }
    },
    {
      "label": {
        "text": "Ver mi rango",
        "color": "gray"
      },
      "width": 170,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger levelrank"
      },
      "tooltip": {
        "text": "Se muestra en el chat.",
        "color": "gray"
      }
    },
    {
      "label": {
        "text": "Volver a la isla",
        "color": "red"
      },
      "width": 170,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger volver"
      },
      "tooltip": {
        "text": "Si hay desafío activo, cuenta como abandono.",
        "color": "gray"
      }
    }
  ]
}